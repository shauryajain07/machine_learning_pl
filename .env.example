# Use the Supabase pooled PostgreSQL connection string for bulk ingestion.
# Do not expose this value to a browser or commit it to the repository.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres


# ---------------------------------------------------------------- MatchSense AI
# Copy to .env (git-ignored). Every key is optional: missing keys disable that
# provider and are reported in the forecast's data-quality panel.
MATCHSENSE_MODE=live                 # live | demo (offline, recorded + simulated)
MATCHSENSE_TIMEZONE=Asia/Hong_Kong
# MATCHSENSE_DEMO_NOW=2026-11-07T08:00:00Z
# MATCHSENSE_SIMULATIONS=2000
# MATCHSENSE_NEWS_WINDOW_HOURS=72
# MATCHSENSE_USE_FPL=1               # keyless Premier League fantasy endpoints
# MATCHSENSE_USE_BBC=1               # keyless BBC Sport club RSS feeds
# MATCHSENSE_USE_OPENFOOTBALL_REMOTE=1
# MATCHSENSE_EXTRA_RSS=Manchester City|https://example.com/club-news.rss

# Fixtures across all competitions, injuries, official starting XIs (api-sports.io)
API_FOOTBALL_KEY=
# Fixtures incl. Champions League / cups (football-data.org free tier)
FOOTBALL_DATA_API_KEY=
# News search
GUARDIAN_API_KEY=
NEWSAPI_KEY=
GNEWS_API_KEY=
# Structured LLM extraction (falls back to the deterministic rule extractor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Query understanding before the pipeline runs: auto | codex | openai | rules.
# auto = Codex CLI (`codex exec`) if installed, else OpenAI if keyed, else rules.
# Interpretations are cached per question; Codex uses ~20k tokens per new question.
MATCHSENSE_QUERY_INTERPRETER=auto
# MATCHSENSE_CODEX_MODEL=
